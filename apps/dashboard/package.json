{
  "name": "@wikimf/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "node --experimental-strip-types scripts/format-check.mjs",
    "test:api": "node scripts/api-smoke.mjs",
    "test": "npm run test:unit && node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
